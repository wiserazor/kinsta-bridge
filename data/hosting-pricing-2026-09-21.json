  "field_notes": {
    "entry_price_per_month_usd": "The monthly-equivalent figure shown for the discounted term (yearly/prepay). For hosts that do not discount, this equals the monthly price.",
    "monthly_price_usd": "The rate the vendor charges when you select monthly billing, if offered.",
    "year_1_total_usd": "What you actually pay in the first year on the entry term, including prepaid years written as a single payment.",
    "renewal_price_per_month_usd": "The rate that applies after the first term, as published by the vendor, or derived when the vendor states the standard rate only.",
    "three_year_total_usd": "Year 1 at the published first-term price plus two years at the published renewal rate. Null or 'unknown' where the vendor does not publish a renewal rate.",
    "est_visits_per_month": "The vendor's own published visitor allowance, not a measurement."
